# DO NOT COMMIT THIS FILE WITH ACTUAL KEYS
# Copy this file to vault-unseal-keys-secret.yaml and replace with your actual keys
# Apply with: kubectl apply -f vault-unseal-keys-secret.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: vault-threshold-keys
  namespace: vault
type: Opaque
stringData:
  key1: "REPLACE_WITH_UNSEAL_KEY_1"
  key2: "REPLACE_WITH_UNSEAL_KEY_2"
  key3: "REPLACE_WITH_UNSEAL_KEY_3"