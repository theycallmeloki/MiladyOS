#!/bin/sh
# MiladyOS dev-ISO hook: bake the operator SSH key into the live rootfs.
# This is the *dev* entry path into the appliance; fleet builds omit it
# (key injection happens at first-boot via operator USB/console instead).
set -e

install -m 0700 -d /root/.ssh
cat > /root/.ssh/authorized_keys <<'EOF'
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINEae9PnoluuQy1LSEGwp18PUOLZTD5ALlwfZCOia0Cg ogmiladyloki@gmail.com
EOF
chmod 0600 /root/.ssh/authorized_keys

# Host keys are NOT baked: the stock 8050 hygiene hook strips /etc/ssh
# keys after config hooks run, and baked keys must not ship anyway.
# milady-sshkeys.service regenerates them on the first boot that lacks
# them (ConditionPathExists=!), ordered before ssh.service.
