#!/bin/sh
# MiladyOS ISO — install k3s (server|agent) with Docker as the runtime.
# Pinned version via K3S_VERSION env (build.sh); default = stable channel.
# The k3s systemd unit is NOT enabled here — role selection enables the
# correct one at first boot (server vs agent).
set -e

# Docker is the k3s runtime (D3) — baked into the unit at install time.
# SKIP_ENABLE: the unit is defined but NOT started/enabled at install —
# role-detect enables exactly one of k3s.service (server) or
# k3s-agent.service (agent, staged from ISO/systemd/) at first boot.
export INSTALL_K3S_EXEC="server --docker"
export INSTALL_K3S_SKIP_ENABLE=true

# Warm cache: the ISO builder may stage a previously installed binary at
# /usr/local/bin/k3s. With it present the installer skips both the download and
# the channel lookup (INSTALL_K3S_SKIP_DOWNLOAD -> verify_k3s_is_executable), so
# a rebuild needs no network for k3s at all.
if [ -x /usr/local/bin/k3s ]; then
    export INSTALL_K3S_SKIP_DOWNLOAD=true
    echo "k3s: using cached binary /usr/local/bin/k3s"
elif [ -n "${K3S_VERSION:-}" ]; then
    export INSTALL_K3S_VERSION="$K3S_VERSION"
elif ! curl -fsS --max-time 15 https://update.k3s.io/v1-release/channels/stable >/dev/null 2>&1; then
    # The channel endpoint can be unreachable or TLS-intercepted on local
    # networks (some proxies present a cert whose SAN does not match, which
    # makes the installer fall back to a literal "stable" URL and 404). The
    # assets still come from GitHub, so resolve the same latest-stable tag
    # from the API and pin that: keeps D5 (no repo-level pin), keeps local
    # builds working, and CI is unaffected (it can reach the channel).
    STABLE=$(curl -fsSL --max-time 20 https://api.github.com/repos/k3s-io/k3s/releases/latest 2>/dev/null \
        | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
    if [ -n "$STABLE" ]; then
        export INSTALL_K3S_VERSION="$STABLE"
        echo "k3s: channel endpoint unreachable, pinned latest stable via API: $STABLE"
    fi
fi

# Cached installer script when the builder staged one, else fetch it.
if [ -f /usr/share/milady/k3s-install.sh ]; then
    cp /usr/share/milady/k3s-install.sh /tmp/k3s-install.sh
else
    curl -fsSL https://get.k3s.io -o /tmp/k3s-install.sh
fi
sh /tmp/k3s-install.sh
rm -f /tmp/k3s-install.sh

echo "k3s $(k3s --version 2>/dev/null | head -1) installed"
