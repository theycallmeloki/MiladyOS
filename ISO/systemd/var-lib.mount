# Mount the labeled MILADY_DOCKER scratch disk at /var/lib so the live-boot
# docker store (docker + containerd image store) and k3s datastore live on
# real disk, not the half-RAM tmpfs overlay. The miladyos image (~6.2GB, 67
# layers) exceeds what the overlay can hold: measured ENOSPC death spiral on
# 16GB overlays even with serial downloads; docker-ce on trixie stores image
# blobs under /var/lib/containerd (containerd image store), so covering only
# /var/lib/docker misses the real growth — the mount must be /var/lib.
# nofail: absent disk = everything stays on tmpfs, boot must not break. The
# 90s stall that used to happen before nofail let boot continue is bounded by
# JobTimeoutSec below (the x-systemd.device-timeout in Options= does not apply
# to a native mount unit; see the note there).
[Unit]
Description=Docker + k3s store on MILADY_DOCKER scratch disk
Requires=persist-docker.service
After=persist-docker.service
# A missing scratch disk must not stall boot. What waits is the *device unit's*
# start job, and for a native .mount unit the fstab-only
# x-systemd.device-timeout= in Options= is inert — measured on systemd 257:
# the job sat for the full 90s DefaultDeviceTimeoutSec. JobTimeoutSec bounds
# the whole mount job instead (measured: 10.0s with JobTimeoutSec=10s, 90.2s
# without). 15s still leaves room for a slow real disk while skipping fast when
# there is none; if the job is cut short /var/lib simply stays on tmpfs and
# `systemctl start var-lib.mount` retries once a disk appears.
JobTimeoutSec=15s

[Mount]
What=/dev/disk/by-label/MILADY_DOCKER
Where=/var/lib
Type=ext4
Options=defaults,nofail,x-systemd.device-timeout=5s

[Install]
WantedBy=multi-user.target
