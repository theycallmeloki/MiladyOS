[Unit]
Description=MiladyOS text installer (serial console)
# Live-only: /run/live/medium exists only when booted from the ISO.
ConditionPathExists=/run/live/medium
# The VGA instance (milady-install.service) runs in parallel on tty1; a flock
# in the installer script makes sure only one of them performs the install.
Conflicts=getty@tty1.service serial-getty@ttyS0.service
After=getty@tty1.service serial-getty@ttyS0.service

[Service]
Type=idle
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
ExecStart=/usr/local/sbin/milady-install
TimeoutStartSec=0
Restart=no

[Install]
WantedBy=multi-user.target
