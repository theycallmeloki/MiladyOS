#!/bin/sh
# milady-watch — open the desktop's browser on milady's live emacs.
#
# GoTTY inside the miladyos container serves emacsclient -t attached to the
# emacs daemon milady drives over MCP, so a browser parked on it shows what
# milady is doing, live ("observe milady"). This launcher waits for the
# container's GoTTY to answer, then parks surf there; if nothing ever answers it
# opens a local page explaining why instead of a browser error.
#
# Runs from the sway config (exec milady-watch) in the role=desktop session.
set -u

# Ports to try, in order:
#   1337 — the "observe milady" emacs client (repo startup.sh since 873eb51)
#   8088 — the plain terminal the *currently published* image still starts
# Trying both means a node works whether its container image predates or
# postdates that change.
GOTTY_PORTS="${MILADY_GOTTY_PORTS:-1337 8088}"
FALLBACK="file:///usr/share/milady/desktop-watch.html"

# surf is the browser: WebKitGTK (GoTTY needs JS + WebSockets, so a text
# browser will not do) and small enough for a light session.
if ! command -v surf >/dev/null 2>&1; then
    echo "milady-watch: surf is not installed" >&2
    exit 1
fi

# WebKitGTK's accelerated compositing wants a working GL stack; on a VM (or any
# box without a GPU driver) llvmpipe is all there is and the window can come up
# blank or not at all. These are the documented escape hatches.
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export LIBGL_ALWAYS_SOFTWARE=1

# GoTTY is behind HTTP basic auth, so any HTTP status (401 included) proves the
# port is alive; only a connection failure returns 000. curl prints "000"
# itself on failure, so the exit status is what needs handling here — an
# `|| echo 000` would append a second 000 and make every attempt look alive.
for port in $GOTTY_PORTS; do
    for _ in $(seq 1 10); do
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 \
            "http://localhost:${port}/" 2>/dev/null) || code=000
        if [ "$code" != "000" ]; then
            # Credentials ride in the URL so the kiosk does not open on an auth
            # prompt; GoTTY's defaults are milady:milady, overridable like startup.sh.
            exec surf "http://${MILADY_ADMIN_ID:-milady}:${MILADY_ADMIN_PASSWORD:-milady}@localhost:${port}/"
        fi
        sleep 1
    done
done

echo "milady-watch: no GoTTY on ${GOTTY_PORTS} — showing the explainer" >&2
exec surf "$FALLBACK"
